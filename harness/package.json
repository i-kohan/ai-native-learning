{
  "name": "harness",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "benchmark": "tsx src/run-benchmark.ts",
    "benchmark:all": "tsx src/run-benchmark.ts --all",
    "benchmark:experiment": "tsx src/run-benchmark.ts --experiment",
    "benchmark:r01": "tsx src/run-benchmark.ts R01",
    "benchmark:rev01": "tsx src/run-benchmark.ts REV01",
    "benchmark:iso01": "tsx src/run-benchmark.ts ISO01",
    "benchmark:sec01": "tsx src/run-benchmark.ts SEC01",
    "benchmark:eval": "tsx src/run-benchmark.ts --eval",
    "benchmark:routing": "tsx src/run-benchmark.ts --routing",
    "benchmark:orchestration": "tsx src/run-benchmark.ts --orchestration",
    "benchmark:planning": "tsx src/run-benchmark.ts --planning",
    "benchmark:subagents": "tsx src/run-benchmark.ts --subagents",
    "benchmark:decomposition": "tsx src/run-benchmark.ts --decomposition",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "openai": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
